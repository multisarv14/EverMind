# Copy to docker.env and fill in. Never commit docker.env.
AUTH_SECRET=change-me-to-a-random-string-of-32-or-more-characters
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# The public address of the site (used in emails and links)
APP_URL=http://localhost:3000

# Optional: send real emails (invitations, password reset), e.g. smtp://user:pass@smtp.example.com:587
SMTP_URL=
MAIL_FROM=EverMind <no-reply@example.com>
