# Copy to docker.env and fill in. Never commit docker.env.
AUTH_SECRET=change-me-to-a-random-string-of-32-or-more-characters
# Encrypts the AI key saved in the database with scripts/set-ai-key.mjs (32+ random characters)
AI_KEY_SECRET=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# The public address of the site (used in emails and links)
APP_URL=http://localhost:3000

# Optional: send real emails (invitations, password reset), e.g. smtp://user:pass@smtp.example.com:587
SMTP_URL=
MAIL_FROM=EverMind <no-reply@example.com>

# Optional: online payments with Razorpay (plans and credit packs). Leave blank to keep "request an upgrade".
# Create the four subscription plans in the Razorpay dashboard with the prices from src/lib/plans.ts + 18% GST,
# and a webhook to https://<your-domain>/api/billing/webhook (see docs/ONBOARDING.md, "Billing").
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_YEARLY=
RAZORPAY_PLAN_BUSINESS_MONTHLY=
RAZORPAY_PLAN_BUSINESS_YEARLY=
