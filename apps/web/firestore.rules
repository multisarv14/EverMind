rules_version = '2';

// Only the EverMind server reads and writes the database, with a service account (which bypasses
// these rules). Browsers and apps never talk to Firestore directly, so everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
